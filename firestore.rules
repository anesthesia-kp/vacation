rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admins ────────────────────────────────────────────────────────────────
    // The admin list lives in vacations/adminAccess (shared by both admin sites).
    function accessDocExists() {
      return exists(/databases/$(database)/documents/vacations/adminAccess)
        && get(/databases/$(database)/documents/vacations/adminAccess).data.get('emails', []).size() > 0;
    }
    function isListedAdmin() {
      return request.auth.token.email.lower() in
             get(/databases/$(database)/documents/vacations/adminAccess).data.get('emails', []);
    }
    function isDefaultAdmin() {
      return request.auth.token.email.lower() in [
        'dr.vacation.goddess@gmail.com',
        'aaronjfrankel@gmail.com'
      ];
    }
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && ((accessDocExists() && isListedAdmin())
            || (!accessDocExists() && isDefaultAdmin()));
    }

    // ── Registered end-users ──────────────────────────────────────────────────
    // A regular user may only write once they are signed in with a VERIFIED
    // Google account whose e-mail is in the shared vacations/loginEmails allow-list
    // (the admin fills this in per person). Emails are stored lower-cased by the
    // admin UI, so this case-sensitive membership check is reliable. This is what
    // replaces the old "any anonymous session may write" rule.
    function isRegisteredUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/vacations/loginEmails)
        && request.auth.token.email.lower() in
           get(/databases/$(database)/documents/vacations/loginEmails).data.values();
    }

    // A verified, NON-anonymous account (i.e. a real Google sign-in). Anonymous
    // bootstrap sessions have no verified e-mail, so this is false for them — which
    // is exactly how the sensitive documents below stay hidden from anonymous
    // internet users while still being readable once someone has signed in.
    function isVerifiedAccount() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // ── Sensitive documents (PII / access control) ────────────────────────────
    // These hold staff e-mail addresses, the Google-login map, and the admin
    // allow-list. They used to be world-readable; now a reader must be signed in
    // with a verified Google account. The apps read them only AFTER sign-in (the
    // staff sites via an authenticated fetch, the admin sites only once an admin
    // has signed in), so nothing in the anonymous login bootstrap depends on them.
    function isSensitiveDoc(docId) {
      return docId in ['loginEmails', 'emails', 'adminAccess', 'emailToUser', 'signInMisses'];
    }

    // ── Bid data [FB-5 stage 1, 19 Aug 2026] ──────────────────────────────────
    // vacations/schedule holds EVERY participant's complete bid list for every week. It
    // fell through to the world-readable default below, so anyone holding the (public,
    // by-design) Firebase config could read the entire live auction WITHOUT SIGNING IN.
    // Nothing on our side depended on that, verified before changing it:
    //   · staff page  — its bids listener is attached only inside startListening(),
    //                   which is called on the post-Google-sign-in path.
    //   · admin pages — every listener is deferred behind authReady, which is resolved
    //                   only inside _enterAdmin(), i.e. after a verified admin sign-in.
    //   · mobile.html — carries no Firebase at all.
    //   · Daily Schedule site — never references this document (grep + isolation test).
    //
    // isVerifiedAccount, NOT isRegisteredUser, DELIBERATELY — this is a cost decision as
    // much as a security one. isRegisteredUser costs an exists() + a get() on loginEmails,
    // and rules document-accesses are BILLED AS READS. This is the most frequently
    // delivered document in the auction, so that would add a recurring per-delivery cost
    // to every bidder's session (see TODO FB-1's arithmetic). isVerifiedAccount reads only
    // the auth token: zero lookups, zero cost. It is also exactly the bar the sensitive
    // PII documents above already use, so this is consistent rather than novel.
    // What it buys: the anonymous-stranger hole is closed. What it does NOT buy: a
    // determined person with any Google account. That case is App Check's job (FB-4), not
    // this rule's. Tightening to isRegisteredUser later is a one-word change.
    function isBidDataDoc(docId) {
      return docId == 'schedule';
    }

    // ── Outbound mail relay [AUDIT 2026-07-25 #6] ─────────────────────────────
    // mailQueue holds pending alert/welcome entries — each carrying a staff e-mail
    // address and the message body. It used to fall through to the world-readable
    // default, so anyone with the (public) Firebase config could poll it from the
    // open internet and harvest exactly the PII that `emails` is gated to protect.
    // Reads now require a REGISTERED user (not merely any verified Google account):
    // outsiders with a Google login are not auction participants and have no reason
    // to see the outbox. The staff site attaches its mailQueue listener only on the
    // signed-in path (same pattern as the L-5 emails listener) so the anonymous
    // login bootstrap never trips this gate with a dead permission-denied listener.
    function isRelayDoc(docId) {
      return docId == 'mailQueue';
    }

    // ── Admin-READ-only documents (live mid-phase decisions) [H-4] ────────────
    // approvals / denials hold the admin's LIVE approve/deny decisions for the
    // current phase. They must never leak before results e-mails go out: the user
    // site deliberately does not listen to them, but that is only UI hygiene — at
    // the rules layer they were world-readable, so anyone could read the live
    // winner/loser list from devtools mid-phase. Reads are now admin-only. NOTE:
    // `phases` is intentionally NOT here — completedPhases snapshots must stay
    // world-readable for the user site's phase-history reports (those are the
    // public channel, released only when a phase is completed).
    // [AUDIT 2026-07-25 #3] 'changesDecisions' joins them: the admin's approve/deny/revoke
    // entries used to be appended to the world-readable `changes` log, which every staff
    // browser already holds — so the live winner/loser list streamed out mid-phase and the
    // H-4 gate above protected nothing in practice. Decisions now live here, admin-only.
    // (Both sites' change-log views already discarded decision entries, so no UI lost data;
    // completePhase archives the merged log into changesArchive once results are public.)
    // [AUDIT 2026-07-26 H6 REDESIGN] 'phaseStaging' joins them: it holds each completed
    // phase's full winner/denial snapshot between Complete Phase and the moment results are
    // announced. That is exactly the mid-phase-private data H6 exists to protect, so it must
    // be admin-read-only (never world-readable like `phases`). Admin-write-only via
    // isAdminOnlyDoc below. It carries NO field the anonymous login bootstrap needs.
    function isAdminReadDoc(docId) {
      return docId in ['approvals', 'denials', 'changesDecisions', 'phaseStaging'];
    }

    // ── Vacation Auction collection ───────────────────────────────────────────
    // Admin-only documents (the auction's control surface + the shared roster,
    // admin list, and login-email allow-list). loginEmails is admin-only so users
    // can never edit who is allowed in.
    // [build 268] 'passcodes' added: the legacy passcode document previously matched no
    // specific clause and fell through to the registered-user catch-all, so any signed-in
    // auction member could overwrite the whole credential map from devtools. The only
    // legitimate writers anywhere are three admin-page paths (clear one password, clear
    // all, Reset Auction); the staff site, mobile page and Daily Schedule site only READ
    // it. Its READ must stay public (isSensitiveDoc must NOT list it): the staff login
    // screen reads it BEFORE sign-in (signinReady gates on _passcodesReady) — gating the
    // read would hang the anonymous login bootstrap.
    function isAdminOnlyDoc(docId) {
      return docId in [
        'approvals',
        'denials',
        'phases',
        'locks',
        'slots',
        'slcMap',
        'fteMap',
        'userList',
        'adminSettings',
        'adminAccess',
        'loginEmails',
        'changesArchive',
        'changesDecisions',
        'phaseStaging',
        'meta',
        'emailToUser',
        'usernames',
        'passcodes',
        'bidLoweringsArchive'
      ];
    }

    // ── Config freeze once the auction is underway [build 268] ────────────────
    // The seven fairness-shaping keys of vacations/adminSettings are FROZEN from the
    // moment Phase 1 begins (rehearsal included) until Reset Auction, server-side —
    // mirroring the admin page's client lock so the promise becomes a guarantee.
    // auctionUnderway() mirrors phase1Started() EXACTLY:
    //     currentPhase > 1  ||  phase1Started == true
    // A missing phases doc means "not started" (same default as the client), so a fresh
    // database stays configurable. Reset Auction overwrites the phases doc with
    // {currentPhase:1, completedPhases:{}} — dropping phase1Started and re-opening the
    // keys for the next auction's setup. NOTE: 'bidLowerings' is frozen here ahead of the
    // feature that writes it, so no second rules publish is needed when it ships.
    function auctionUnderway() {
      return exists(/databases/$(database)/documents/vacations/phases)
        && (get(/databases/$(database)/documents/vacations/phases).data.get('phase1Started', false) == true
            || (get(/databases/$(database)/documents/vacations/phases).data.get('currentPhase', 1) is number
                && get(/databases/$(database)/documents/vacations/phases).data.get('currentPhase', 1) > 1));
    }
    // Does this write ADD, CHANGE, REMOVE or (via document delete) DESTROY a frozen key?
    // Every legitimate mid-auction settings write is a single-key merge (emailNotifs,
    // simulatorEnabled, fteEditEnabled, timerRules, requiredBuilds, …) and is unaffected.
    // diff() compares VALUES, so re-writing an IDENTICAL config — what a same-auction
    // restore does — does not count as touching the key and stays allowed.
    function frozenConfigKeys() {
      return ['auctionConfig', 'bidFloors', 'npAllowedPhases',
              'maxBidsPerPhase', 'maxBidsCumulative', 'reviewThreshold', 'bidLowerings'];
    }
    function touchesFrozenConfig() {
      return request.method == 'delete'
        ? (resource != null && resource.data.keys().hasAny(frozenConfigKeys()))
        : (resource == null
            ? request.resource.data.keys().hasAny(frozenConfigKeys())
            : request.resource.data.diff(resource.data).affectedKeys().hasAny(frozenConfigKeys()));
    }
    // ── [build 268 · GAP] Between-phases unlock (owner ruling 15 Aug) ─────────
    // The frozen dials re-open in the GAP after a phase's (or Phase-4 round's) results
    // are SENT and before the next phase/round begins — decisions are done and PUBLISHED.
    // Deliberately still locked: the window between Complete Phase and Send Results
    // (decisions exist but are private — the manipulation hole the freeze closes).
    // Mirrors the client's _phaseGapNow() exactly; the pin test binds the two.
    function inPhaseGap() {
      return exists(/databases/$(database)/documents/vacations/phases)
        && ((get(/databases/$(database)/documents/vacations/phases).data
               .get('completedPhases', {})
               .get(string(get(/databases/$(database)/documents/vacations/phases).data.get('currentPhase', 1)), null) != null
             && get(/databases/$(database)/documents/vacations/phases).data
               .get('resultsSent', {})
               .get(string(get(/databases/$(database)/documents/vacations/phases).data.get('currentPhase', 1)), null) != null)
            || (get(/databases/$(database)/documents/vacations/phases).data.get('currentPhase', 1) == 4
                && get(/databases/$(database)/documents/vacations/phases).data
                  .get('p4RoundResultsSent', {})
                  .get(string(get(/databases/$(database)/documents/vacations/phases).data.get('p4Round', 1)), null) != null));
    }
    // Even in a gap the auction YEAR may never change: every bid is keyed to the year's
    // weeks, and a year change renames all 52 week keys under live bids (Reset only).
    // A gap write that doesn't touch auctionConfig passes trivially; one that does must
    // carry the SAME year as the saved config (or the built-in default year 2027 when no
    // config was ever saved — both pages' AC_DEFAULTS literal). Whole-doc deletes and
    // key-removals fail the year comparison and stay blocked in gaps too.
    function gapCalendarOk() {
      return request.method != 'delete'
        && ((resource == null
              ? !request.resource.data.keys().hasAny(['auctionConfig'])
              : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['auctionConfig']))
            || (request.resource.data.get('auctionConfig', null) != null
                && request.resource.data.get('auctionConfig', {}).get('year', -1)
                   == (resource != null && resource.data.get('auctionConfig', null) != null
                        ? resource.data.get('auctionConfig', {}).get('year', -2)
                        : 2027)));
    }
    // Cheap tests first: the phases lookup only happens when a frozen key is actually
    // touched, so ordinary settings toggles cost zero extra document-access calls.
    function configWriteAllowed(docId) {
      return docId != 'adminSettings' || !touchesFrozenConfig() || !auctionUnderway()
        || (inPhaseGap() && gapCalendarOk()); // [build 268 · GAP]
    }

    // ── Bid documents: per-user confinement + server-clock expiry [H-3 / H-13] ─
    // These four docs hold the users' own bids. A registered user may only touch
    // the top-level key(s) that belong to THEM (looked up in vacations/emailToUser,
    // which only admins can write), and only while the countdown timer has not
    // expired BY THE SERVER'S CLOCK — so a device with a skewed clock (or devtools)
    // can neither bid after expiry nor resurrect a closed phase. Admins bypass both.
    // [build 268 · BL] 'bidLowerings' joins the bid docs: {USER:{used:n}} — the per-user
    // lowering-usage counter. A lowering IS a bid action, so it inherits exactly the bid
    // docs' guards: own-top-level-key confinement, server-clock timer expiry, and the
    // explicit biddingClosed flag; admins bypass. (Value forgery within one's own key is
    // the same documented residual as bid values themselves — the append-only change log
    // and the Fair Play monitor are the cross-check.)
    function isBidDoc(docId) {
      return docId in ['schedule', 'bestBids', 'bidTimes', 'bidPhase', 'bidLowerings'];
    }
    function myInitials() {
      return get(/databases/$(database)/documents/vacations/emailToUser).data
             .get(request.auth.token.email.lower(), []);
    }
    function writesOnlyOwnKeys() {
      // Bootstrap fallback: if the emailToUser map doesn't exist yet, skip
      // confinement (matches the original H-3 design). Once it exists, an
      // unmapped e-mail can write nothing — the admin sites keep it synced.
      return !exists(/databases/$(database)/documents/vacations/emailToUser)
        || (resource == null
             ? request.resource.data.keys().hasOnly(myInitials())
             : request.resource.data.diff(resource.data).affectedKeys().hasOnly(myInitials()));
    }
    function timerNotExpired() {
      // Uses request.time (Google's clock), never the client's. Timer off, not yet
      // started, or the doc not existing at all means no restriction — the exists()
      // guard matters: get() on a missing doc ERRORS (evaluating to deny), which
      // would silently block every bid on a fresh database.
      return !exists(/databases/$(database)/documents/vacations/timer)
        || !(get(/databases/$(database)/documents/vacations/timer).data.get('enabled', false) == true)
        || get(/databases/$(database)/documents/vacations/timer).data.get('lastChange', null) == null
        || request.time.toMillis() < get(/databases/$(database)/documents/vacations/timer).data.get('lastChange', 0)
             + int(get(/databases/$(database)/documents/vacations/timer).data.get('durationHours', 48) * 3600000);
    }
    // Has the admin explicitly CLOSED bidding? [AUDIT 2026-07-25 #2]
    // Bid writes used to be gated by the timer alone, so with the timer switched OFF a
    // registered user could keep writing bids from devtools after "Close Phase Bidding" —
    // while the admin was approving. Per-week locks can't be checked here (week keys sit
    // inside nested maps that rules cannot diff), so the admin sets one explicit flag.
    // It lives on the TIMER doc on purpose: timerNotExpired() already fetches that
    // document and identical lookups are cached, so this gate costs ZERO extra
    // document-access calls — a bid write is already near Firestore's limit of 10.
    // Users cannot clear it: timerWriteSane() confines their timer writes to
    // lastChange/durationHours. Begin Phase and Reset Auction clear it.
    function biddingNotClosed() {
      return !exists(/databases/$(database)/documents/vacations/timer)
        || get(/databases/$(database)/documents/vacations/timer).data.get('biddingClosed', false) != true;
    }
    // User timer writes may only touch lastChange/durationHours with sane values.
    // [AUDIT 2026-07-25 #1] The old version bounded lastChange but left durationHours
    // at "> 0 && <= 2160", so any registered bidder could write durationHours:0.001 and
    // force-expire the phase for everyone (the first open admin page then auto-locks all
    // 52 weeks), or 2160 to stall it for 90 days. Three tightenings:
    //   1. duration floor of 1h — the client engine's stages are 3/6/12/24/48h, and the
    //      quiet-hours adjustment only ever EXTENDS, so 1 is well below anything real.
    //   2. duration ceiling of 72h — users never legitimately exceed the 48h stage-0
    //      value (long opening windows are written by admins, who bypass this function).
    //   3. the resulting deadline must still be at least an hour out BY THE SERVER CLOCK.
    //   4. [AUDIT 2026-07-26 H5/H8] EXTEND-ONLY: the new deadline may never land earlier
    //      than the existing one. Clauses 1-3 alone still let a registered bidder cut a
    //      47-hour countdown to ~65 minutes from devtools (and re-pin it there forever).
    //      Legitimate user timer writes are bid-driven resets; the staff site skips the
    //      write whenever its reset would not extend the current deadline, so this rule
    //      matches the client exactly. Admins bypass this function and can still shorten.
    function timerWriteSane() {
      return (resource == null
                ? request.resource.data.keys().hasOnly(['lastChange', 'durationHours'])
                : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastChange', 'durationHours']))
        && request.resource.data.get('lastChange', 0) is number
        && request.resource.data.get('lastChange', 0) > request.time.toMillis() - 600000
        && request.resource.data.get('lastChange', 0) < request.time.toMillis() + 600000
        && request.resource.data.get('durationHours', 48) is number
        && request.resource.data.get('durationHours', 48) >= 1
        && request.resource.data.get('durationHours', 48) <= 72
        && request.resource.data.get('lastChange', 0)
             + int(request.resource.data.get('durationHours', 48) * 3600000)
           > request.time.toMillis() + 3600000
        && (resource == null
            || resource.data.get('enabled', false) != true
            || resource.data.get('lastChange', null) == null
            || !(resource.data.get('lastChange', 0) is number)
            || !(resource.data.get('durationHours', 48) is number)
            || request.resource.data.get('lastChange', 0)
                 + int(request.resource.data.get('durationHours', 48) * 3600000)
               >= resource.data.get('lastChange', 0)
                 + int(resource.data.get('durationHours', 48) * 3600000));
    }

    match /vacations/{docId} {
      // Read: live-decision docs (approvals/denials) require admin; sensitive PII
      // docs require a verified sign-in; everything else (roster, usernames, phases,
      // schedule, …) stays public for the anonymous login screen.
      allow read: if isAdminReadDoc(docId) ? isAdmin()
                   : (isRelayDoc(docId) ? (isRegisteredUser() || isAdmin())
                   : ((isSensitiveDoc(docId) || isBidDataDoc(docId)) ? isVerifiedAccount() : true));
      // welcomeLog only records which addresses have already been welcomed (no PII, no
      // control data). [L-8] Writable by a REGISTERED user or an admin — tightened from
      // "any verified Google account" so a signed-in outsider who isn't in the auction
      // can't touch it. [L1 · APPEND-ONLY, enforced by CONTAINMENT] A registered user may only
      // ADD marks under the single 'sent' map (never remove keys, never touch other fields, never
      // wipe the doc) — the legitimate staff writer is setDoc({sent:{<key>:true}},{merge:true}),
      // whose post-image always contains the old keys, so nothing legitimate is blocked. This
      // closes the ERASE hole (a signed-in user resetting the ledger to re-spam every welcome).
      // Admins bypass via isAdmin() (Reset Auction clears it). The forge-half — pre-seeding one
      // key to suppress one user's welcome — cannot be closed in rules (a key can't be tied to
      // the caller) and is a documented, low-impact residual, mirroring the 'changes' rule.
      allow write: if (isAdminOnlyDoc(docId) && isAdmin() && configWriteAllowed(docId)) // [build 268] config freeze
                   || (docId == 'welcomeLog' && (isAdmin()
                        || (isRegisteredUser()
                             && (resource == null
                                  ? request.resource.data.keys().hasOnly(['sent'])
                                  : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sent']))
                             && request.resource.data.get('sent', {}) is map
                             && (resource == null
                                  || !(resource.data.get('sent', null) is map)
                                  || request.resource.data.get('sent', {}).keys().hasAll(resource.data.get('sent', {}).keys())))))
                   // Bid docs: own keys only, and never after server-clock expiry.
                   || (isBidDoc(docId) && (isAdmin()
                        || (isRegisteredUser() && writesOnlyOwnKeys() && timerNotExpired() && biddingNotClosed())))
                   // The timer itself: users may reset it via bids — but not once it has
                   // truly expired (a skewed clock could otherwise reopen bidding), and only
                   // with a fresh, sane lastChange/duration (no forced-expiry or stalling
                   // writes from devtools).
                   || (docId == 'timer' && (isAdmin() || (isRegisteredUser() && timerNotExpired() && timerWriteSane())))
                   // KP-address book: each user may edit only their OWN entry (an insider
                   // could otherwise silently redirect a competitor's outbid alerts).
                   || (docId == 'emails' && (isAdmin() || (isRegisteredUser() && writesOnlyOwnKeys())))
                   // Sign-in miss log: a verified Google account may record ONLY its own
                   // failed-match key (admins may also clear/write the whole doc). Confining
                   // to the caller's own e-mail stops an outsider wiping or flooding the log.
                   || (docId == 'signInMisses' && (isAdmin()
                        || (isVerifiedAccount() && (resource == null
                             ? request.resource.data.keys().hasOnly([request.auth.token.email.lower()])
                             : request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.token.email.lower()])))))
                   // Change log: [AUDIT 2026-07-26 H9] users may only APPEND to the 'log'
                   // array — never delete the doc, truncate the array, or touch other keys.
                   // The staff writer is arrayUnion on 'log' (append), so nothing legitimate
                   // is blocked. This closes the ERASE half of H9 (a bidder wiping their own
                   // late-cancel trail, or the whole 24h feed). The FORGE half — appending an
                   // entry that names a colleague — cannot be closed in rules (entry contents
                   // in a dynamic array cannot be validated per-item); it remains a documented
                   // insider risk for the Fair Play Monitor, which is advisory to the admin.
                   // [AUDIT 2026-07-26 H9 v2] APPEND-ONLY, enforced by CONTAINMENT. The first
                   // cut only required the new log to be no SHORTER than the old — which a
                   // same-length replacement trivially satisfies while dropping the real
                   // entries (read the world-readable log, rebuild it with padding, write it
                   // back: size 10 >= 10, accepted). The re-audit confirmed the erase hole was
                   // still open. hasAll() requires the new log to CONTAIN every existing entry,
                   // so nothing can be removed or altered — only appended. The staff writer is
                   // arrayUnion('log',…), whose post-image is always a superset, so it still
                   // passes. (Admins bypass via isAdmin() to reset the log at phase completion.)
                   // The FORGE half — appending an entry naming a colleague — still cannot be
                   // closed in rules and remains the documented insider risk.
                   || (docId == 'changes' && (isAdmin()
                        || (isRegisteredUser()
                             && (resource == null
                                  ? request.resource.data.keys().hasOnly(['log'])
                                  : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['log']))
                             && request.resource.data.get('log', []) is list
                             && (resource == null
                                  || !(resource.data.get('log', null) is list)
                                  || request.resource.data.get('log', []).hasAll(resource.data.get('log', []))))))
                   // Mail outbox: [AUDIT 2026-07-26 H15, partial] every legitimate relay
                   // write (enqueue / claim / sentTo / delete-after-send) touches exactly ONE
                   // top-level entry, so a user write may affect at most one key. This stops
                   // `setDoc(mailQueueRef,{})` destroying every pending alert in one shot.
                   // Residual (documented): a registered user can still forge one entry's
                   // content or delete one entry per write — full validation needs a server.
                   || (isRelayDoc(docId) && (isAdmin()
                        || (isRegisteredUser()
                             && (resource == null
                                  ? request.resource.data.keys().size() <= 1
                                  : request.resource.data.diff(resource.data).affectedKeys().size() <= 1))))
                   // Whitelist confirmations [WHITELIST TRACKER 2026-07-26]: each entry is
                   // {initials: {confirmedAt}} — a user's self-report that they've added the
                   // auction sender to their Google contacts / marked it Not-Spam. A registered
                   // user may write ONLY their own initials key (writesOnlyOwnKeys, same guard as
                   // the emails doc), so nobody can forge or clear a colleague's confirmation;
                   // the admin may write/clear the whole doc. Read falls through to the public
                   // default below (initials→timestamp only, no PII), which the admin panel and
                   // the staff banner both read. Isolated from the auction: no auction doc, engine,
                   // or phase logic touches it.
                   || (docId == 'whitelistConfirm' && (isAdmin() || (isRegisteredUser() && writesOnlyOwnKeys())))
                   || (!isAdminOnlyDoc(docId) && !isBidDoc(docId) && !isRelayDoc(docId)
                        && docId != 'timer' && docId != 'signInMisses' && docId != 'emails'
                        && docId != 'changes' && docId != 'whitelistConfirm' && docId != 'welcomeLog'
                        && (isRegisteredUser() || isAdmin()));
    }

    // ── Daily Schedule collection ─────────────────────────────────────────────
    // The Daily Schedule has its OWN admin list (dailysched/adminAccess), fully
    // independent of the Vacation Auction's vacations/adminAccess — granting or
    // revoking a schedule admin never affects who can administer the auction. The
    // two built-in default admins still work on both sites while a list is empty.
    function schedAccessDocExists() {
      return exists(/databases/$(database)/documents/dailysched/adminAccess)
        && get(/databases/$(database)/documents/dailysched/adminAccess).data.get('emails', []).size() > 0;
    }
    function isSchedAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && ((schedAccessDocExists()
              && request.auth.token.email.lower() in
                 get(/databases/$(database)/documents/dailysched/adminAccess).data.get('emails', []))
            || (!schedAccessDocExists() && isDefaultAdmin()));
    }
    // [H-5, part 1] 'fteMap' added — the schedule FTE source is only ever read/written
    // by sched-admin, so locking it to schedule-admins closes a tampering hole with no
    // functional impact. (The deeper H-5 fix for requests/swaps/auditLog — per-author
    // validation — needs a subcollection migration and is deferred with the schedule site.)
    function isSchedAdminOnlyDoc(docId) {
      return docId in ['shiftCatalog', 'eligibility', 'openShifts', 'callTotals', 'callBaseline', 'fteMap', 'adminAccess']
        || docId.matches('sched_.*');
    }

    match /dailysched/{docId} {
      // The schedule's own admin list names people, so it is not world-readable;
      // everything else in the schedule stays public for the anonymous bootstrap.
      allow read: if docId != 'adminAccess' || isVerifiedAccount();
      allow write: if (isSchedAdminOnlyDoc(docId) && isSchedAdmin())
                   || (!isSchedAdminOnlyDoc(docId) && (isRegisteredUser() || isSchedAdmin()));
    }

    // [schedule 59/63/68] SUBCOLLECTIONS under dailysched documents:
    //   sched_YYYY-MM/days/{dd}    — one doc per day of the month            [59]
    //   auditLog/entries/{id}      — one doc per audit entry                 [63]
    //   requests/items/{id} · swaps/items/{id} · openShifts/items/{id}       [68]
    // The flat match above does NOT reach these — Firestore matches are not
    // recursive — so without this block the catch-all at the bottom denies every
    // subcollection read and write. Policy mirrors the parent document exactly:
    // world-readable (the anonymous bootstrap), and the write split keyed on the
    // PARENT doc id, so days under a sched_* month and items under openShifts stay
    // admin-only while requests/swaps items accept registered users — the same
    // people who could write those parent docs before. (H-5's per-author
    // validation remains deferred, unchanged in scope by this block.)
    match /dailysched/{docId}/{sub}/{itemId} {
      allow read: if true;
      allow write: if (isSchedAdminOnlyDoc(docId) && isSchedAdmin())
                   || (!isSchedAdminOnlyDoc(docId) && (isRegisteredUser() || isSchedAdmin()));
    }

    // ── Cloud Backups [admin build 213] ───────────────────────────────────────
    // Admin-only snapshot store. backups/{backupId} holds a manifest (when / who /
    // build / counts / the list of piece names), and backups/{backupId}/docs/{docName}
    // holds one piece per backed-up document as a JSON-string payload. Never
    // world-readable: a snapshot contains the FULL auction state, including the
    // mid-phase approvals/denials that H6 exists to protect, so read and write are
    // both admin-gated. No user-facing page touches this collection.
    match /backups/{backupId} {
      allow read, write: if isAdmin();
      match /docs/{docName} {
        allow read, write: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
