rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admins ────────────────────────────────────────────────────────────────
    // The admin list lives in vacations/adminAccess (shared by both admin sites).
    function accessDocExists() {
      return exists(/databases/$(database)/documents/vacations/adminAccess)
        && get(/databases/$(database)/documents/vacations/adminAccess).data.get('emails', []).size() > 0;
    }
    function isListedAdmin() {
      return request.auth.token.email.lower() in
             get(/databases/$(database)/documents/vacations/adminAccess).data.get('emails', []);
    }
    function isDefaultAdmin() {
      return request.auth.token.email.lower() in [
        'dr.vacation.goddess@gmail.com',
        'aaronjfrankel@gmail.com'
      ];
    }
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && ((accessDocExists() && isListedAdmin())
            || (!accessDocExists() && isDefaultAdmin()));
    }

    // ── Registered end-users ──────────────────────────────────────────────────
    // A regular user may only write once they are signed in with a VERIFIED
    // Google account whose e-mail is in the shared vacations/loginEmails allow-list
    // (the admin fills this in per person). Emails are stored lower-cased by the
    // admin UI, so this case-sensitive membership check is reliable. This is what
    // replaces the old "any anonymous session may write" rule.
    function isRegisteredUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/vacations/loginEmails)
        && request.auth.token.email.lower() in
           get(/databases/$(database)/documents/vacations/loginEmails).data.values();
    }

    // A verified, NON-anonymous account (i.e. a real Google sign-in). Anonymous
    // bootstrap sessions have no verified e-mail, so this is false for them — which
    // is exactly how the sensitive documents below stay hidden from anonymous
    // internet users while still being readable once someone has signed in.
    function isVerifiedAccount() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // ── Sensitive documents (PII / access control) ────────────────────────────
    // These hold staff e-mail addresses, the Google-login map, and the admin
    // allow-list. They used to be world-readable; now a reader must be signed in
    // with a verified Google account. The apps read them only AFTER sign-in (the
    // staff sites via an authenticated fetch, the admin sites only once an admin
    // has signed in), so nothing in the anonymous login bootstrap depends on them.
    function isSensitiveDoc(docId) {
      return docId in ['loginEmails', 'emails', 'adminAccess', 'emailToUser', 'signInMisses'];
    }

    // ── Outbound mail relay [AUDIT 2026-07-25 #6] ─────────────────────────────
    // mailQueue holds pending alert/welcome entries — each carrying a staff e-mail
    // address and the message body. It used to fall through to the world-readable
    // default, so anyone with the (public) Firebase config could poll it from the
    // open internet and harvest exactly the PII that `emails` is gated to protect.
    // Reads now require a REGISTERED user (not merely any verified Google account):
    // outsiders with a Google login are not auction participants and have no reason
    // to see the outbox. The staff site attaches its mailQueue listener only on the
    // signed-in path (same pattern as the L-5 emails listener) so the anonymous
    // login bootstrap never trips this gate with a dead permission-denied listener.
    function isRelayDoc(docId) {
      return docId == 'mailQueue';
    }

    // ── Admin-READ-only documents (live mid-phase decisions) [H-4] ────────────
    // approvals / denials hold the admin's LIVE approve/deny decisions for the
    // current phase. They must never leak before results e-mails go out: the user
    // site deliberately does not listen to them, but that is only UI hygiene — at
    // the rules layer they were world-readable, so anyone could read the live
    // winner/loser list from devtools mid-phase. Reads are now admin-only. NOTE:
    // `phases` is intentionally NOT here — completedPhases snapshots must stay
    // world-readable for the user site's phase-history reports (those are the
    // public channel, released only when a phase is completed).
    function isAdminReadDoc(docId) {
      return docId in ['approvals', 'denials'];
    }

    // ── Vacation Auction collection ───────────────────────────────────────────
    // Admin-only documents (the auction's control surface + the shared roster,
    // admin list, and login-email allow-list). loginEmails is admin-only so users
    // can never edit who is allowed in.
    function isAdminOnlyDoc(docId) {
      return docId in [
        'approvals',
        'denials',
        'phases',
        'locks',
        'slots',
        'slcMap',
        'fteMap',
        'userList',
        'adminSettings',
        'adminAccess',
        'loginEmails',
        'changesArchive',
        'meta',
        'emailToUser',
        'usernames'
      ];
    }

    // ── Bid documents: per-user confinement + server-clock expiry [H-3 / H-13] ─
    // These four docs hold the users' own bids. A registered user may only touch
    // the top-level key(s) that belong to THEM (looked up in vacations/emailToUser,
    // which only admins can write), and only while the countdown timer has not
    // expired BY THE SERVER'S CLOCK — so a device with a skewed clock (or devtools)
    // can neither bid after expiry nor resurrect a closed phase. Admins bypass both.
    function isBidDoc(docId) {
      return docId in ['schedule', 'bestBids', 'bidTimes', 'bidPhase'];
    }
    function myInitials() {
      return get(/databases/$(database)/documents/vacations/emailToUser).data
             .get(request.auth.token.email.lower(), []);
    }
    function writesOnlyOwnKeys() {
      // Bootstrap fallback: if the emailToUser map doesn't exist yet, skip
      // confinement (matches the original H-3 design). Once it exists, an
      // unmapped e-mail can write nothing — the admin sites keep it synced.
      return !exists(/databases/$(database)/documents/vacations/emailToUser)
        || (resource == null
             ? request.resource.data.keys().hasOnly(myInitials())
             : request.resource.data.diff(resource.data).affectedKeys().hasOnly(myInitials()));
    }
    function timerNotExpired() {
      // Uses request.time (Google's clock), never the client's. Timer off, not yet
      // started, or the doc not existing at all means no restriction — the exists()
      // guard matters: get() on a missing doc ERRORS (evaluating to deny), which
      // would silently block every bid on a fresh database.
      return !exists(/databases/$(database)/documents/vacations/timer)
        || !(get(/databases/$(database)/documents/vacations/timer).data.get('enabled', false) == true)
        || get(/databases/$(database)/documents/vacations/timer).data.get('lastChange', null) == null
        || request.time.toMillis() < get(/databases/$(database)/documents/vacations/timer).data.get('lastChange', 0)
             + int(get(/databases/$(database)/documents/vacations/timer).data.get('durationHours', 48) * 3600000);
    }
    // User timer writes may only touch lastChange/durationHours with sane values.
    // [AUDIT 2026-07-25 #1] The old version bounded lastChange but left durationHours
    // at "> 0 && <= 2160", so any registered bidder could write durationHours:0.001 and
    // force-expire the phase for everyone (the first open admin page then auto-locks all
    // 52 weeks), or 2160 to stall it for 90 days. Three tightenings:
    //   1. duration floor of 1h — the client engine's stages are 3/6/12/24/48h, and the
    //      quiet-hours adjustment only ever EXTENDS, so 1 is well below anything real.
    //   2. duration ceiling of 72h — users never legitimately exceed the 48h stage-0
    //      value (long opening windows are written by admins, who bypass this function).
    //   3. the resulting deadline must still be at least an hour out BY THE SERVER CLOCK.
    //      This is the one that actually closes the hole: a clamp on durationHours alone
    //      is defeated by a legal 10-minute-old lastChange plus a small duration.
    function timerWriteSane() {
      return (resource == null
                ? request.resource.data.keys().hasOnly(['lastChange', 'durationHours'])
                : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastChange', 'durationHours']))
        && request.resource.data.get('lastChange', 0) is number
        && request.resource.data.get('lastChange', 0) > request.time.toMillis() - 600000
        && request.resource.data.get('lastChange', 0) < request.time.toMillis() + 600000
        && request.resource.data.get('durationHours', 48) is number
        && request.resource.data.get('durationHours', 48) >= 1
        && request.resource.data.get('durationHours', 48) <= 72
        && request.resource.data.get('lastChange', 0)
             + int(request.resource.data.get('durationHours', 48) * 3600000)
           > request.time.toMillis() + 3600000;
    }

    match /vacations/{docId} {
      // Read: live-decision docs (approvals/denials) require admin; sensitive PII
      // docs require a verified sign-in; everything else (roster, usernames, phases,
      // schedule, …) stays public for the anonymous login screen.
      allow read: if isAdminReadDoc(docId) ? isAdmin()
                   : (isRelayDoc(docId) ? (isRegisteredUser() || isAdmin())
                   : (isSensitiveDoc(docId) ? isVerifiedAccount() : true));
      // welcomeLog only records which addresses have already been welcomed (no PII, no
      // control data). [L-8] Writable by a REGISTERED user or an admin — tightened from
      // "any verified Google account" so a signed-in outsider who isn't in the auction
      // can't touch it. The "already welcomed" mark still can't be silently denied for
      // legitimate users, so duplicate welcome e-mails stay prevented.
      allow write: if (isAdminOnlyDoc(docId) && isAdmin())
                   || (docId == 'welcomeLog' && (isRegisteredUser() || isAdmin()))
                   // Bid docs: own keys only, and never after server-clock expiry.
                   || (isBidDoc(docId) && (isAdmin()
                        || (isRegisteredUser() && writesOnlyOwnKeys() && timerNotExpired())))
                   // The timer itself: users may reset it via bids — but not once it has
                   // truly expired (a skewed clock could otherwise reopen bidding), and only
                   // with a fresh, sane lastChange/duration (no forced-expiry or stalling
                   // writes from devtools).
                   || (docId == 'timer' && (isAdmin() || (isRegisteredUser() && timerNotExpired() && timerWriteSane())))
                   // KP-address book: each user may edit only their OWN entry (an insider
                   // could otherwise silently redirect a competitor's outbid alerts).
                   || (docId == 'emails' && (isAdmin() || (isRegisteredUser() && writesOnlyOwnKeys())))
                   // Sign-in miss log: a verified Google account may record ONLY its own
                   // failed-match key (admins may also clear/write the whole doc). Confining
                   // to the caller's own e-mail stops an outsider wiping or flooding the log.
                   || (docId == 'signInMisses' && (isAdmin()
                        || (isVerifiedAccount() && (resource == null
                             ? request.resource.data.keys().hasOnly([request.auth.token.email.lower()])
                             : request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.token.email.lower()])))))
                   || (!isAdminOnlyDoc(docId) && !isBidDoc(docId)
                        && docId != 'timer' && docId != 'signInMisses' && docId != 'emails'
                        && (isRegisteredUser() || isAdmin()));
    }

    // ── Daily Schedule collection ─────────────────────────────────────────────
    // The Daily Schedule has its OWN admin list (dailysched/adminAccess), fully
    // independent of the Vacation Auction's vacations/adminAccess — granting or
    // revoking a schedule admin never affects who can administer the auction. The
    // two built-in default admins still work on both sites while a list is empty.
    function schedAccessDocExists() {
      return exists(/databases/$(database)/documents/dailysched/adminAccess)
        && get(/databases/$(database)/documents/dailysched/adminAccess).data.get('emails', []).size() > 0;
    }
    function isSchedAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && ((schedAccessDocExists()
              && request.auth.token.email.lower() in
                 get(/databases/$(database)/documents/dailysched/adminAccess).data.get('emails', []))
            || (!schedAccessDocExists() && isDefaultAdmin()));
    }
    // [H-5, part 1] 'fteMap' added — the schedule FTE source is only ever read/written
    // by sched-admin, so locking it to schedule-admins closes a tampering hole with no
    // functional impact. (The deeper H-5 fix for requests/swaps/auditLog — per-author
    // validation — needs a subcollection migration and is deferred with the schedule site.)
    function isSchedAdminOnlyDoc(docId) {
      return docId in ['shiftCatalog', 'eligibility', 'openShifts', 'callTotals', 'callBaseline', 'fteMap', 'adminAccess']
        || docId.matches('sched_.*');
    }

    match /dailysched/{docId} {
      // The schedule's own admin list names people, so it is not world-readable;
      // everything else in the schedule stays public for the anonymous bootstrap.
      allow read: if docId != 'adminAccess' || isVerifiedAccount();
      allow write: if (isSchedAdminOnlyDoc(docId) && isSchedAdmin())
                   || (!isSchedAdminOnlyDoc(docId) && (isRegisteredUser() || isSchedAdmin()));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
