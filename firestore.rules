rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
             'dr.vacation.goddess@gmail.com',
             'aaronjfrankel@gmail.com'
           ];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdminOnlyDoc(docId) {
      return docId in [
        'approvals',
        'denials',
        'phases',
        'locks',
        'slots',
        'fteMap',
        'userList',
        'adminSettings',
        'changesArchive',
        'meta'
      ];
    }

    match /vacations/{docId} {
      allow read: if true;
      allow write: if (isAdminOnlyDoc(docId) && isAdmin())
                   || (!isAdminOnlyDoc(docId) && isSignedIn());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
