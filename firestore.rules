rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Vacation Auction — Firestore Security Rules
//
// DO NOT PUBLISH until the admin site (build 59+) and user site are deployed
// and you have confirmed Google sign-in works on the live admin page.
//
// How to publish: Firebase Console → Build → Firestore Database → Rules tab →
// replace everything with this file's contents → Publish.
//
// What these rules do:
//  • READS are open — both sites read freely (the bidding board is public
//    to your group by design; nothing secret is stored in plain text).
//  • ADMIN documents (approvals, denials, phases, locks, FTE, users,
//    settings…) accept writes ONLY from a signed-in, verified Google
//    account on the e-mail list below. Enforced by Google's servers —
//    it cannot be bypassed from a browser.
//  • USER documents (bids, bid times, change log, e-mails…) accept writes
//    from any signed-in session, including the invisible anonymous sign-in
//    the user site performs. Random internet traffic with no session at
//    all is rejected.
//
// To add/remove an admin: edit the e-mail list in isAdmin() below and
// Publish again (also update ADMIN_EMAILS near the top of the admin page's
// script so the page gate matches).
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
             'dr.vacation.goddess@gmail.com',
             'aaronjfrankel@gmail.com'
           ];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Documents only the admin may write. Everything not in this list is a
    // user-writable document (bids and bid-adjacent data).
    function isAdminOnlyDoc(docId) {
      return docId in [
        'approvals',      // admin approve decisions
        'denials',        // admin deny decisions
        'phases',         // current phase, snapshots, results-sent flags
        'locks',          // week locks + global lock
        'slots',          // per-week FTE availability
        'fteMap',         // per-user FTE
        'userList',       // roster
        'adminSettings',  // all admin toggles/settings
        'changesArchive', // archived change logs
        'meta'            // misc admin metadata
      ];
    }

    match /vacations/{docId} {
      allow read: if true;
      allow write: if (isAdminOnlyDoc(docId) && isAdmin())
                   || (!isAdminOnlyDoc(docId) && isSignedIn());
    }

    // Nothing outside /vacations is used by the app — deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
